# Backend environment variables
# Copy this to .env and fill in your values.

# --- Database ---
# Local dev: sqlite:///./meetingmind.db
# Render with persistent disk: sqlite:////data/meetingmind.db
DATABASE_URL=sqlite:///./meetingmind.db

# --- CORS ---
# Comma-separated list of allowed origins.
# Set to your Vercel URL in production: https://your-app.vercel.app
CORS_ORIGINS=["http://localhost:3000"]

# --- LLM Provider ---
# Options: mock | openai | anthropic
# "mock" requires no API key and generates placeholder summaries.
LLM_PROVIDER=mock

# Provide key if using openai or anthropic
# LLM_API_KEY=sk-...

# --- Seeding ---
# Set to true on first deploy to populate sample meetings.
# Disable after first boot to prevent re-seeding on restarts.
SEED_ON_BOOT=false

# --- App ---
DEBUG=false
